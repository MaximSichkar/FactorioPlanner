
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <meta name="google" content="notranslate" />

    <title>@ViewData["Title"] - Factorio Planner</title>

    <link rel="stylesheet"
          href="~/css/helmod.css"
          asp-append-version="true" />
</head>
<body class="planner-body">

    <main class="planner-workspace">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
